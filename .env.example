# Copy this to .env -- no API keys needed since we use local Ollama!

GITHUB_TOKEN=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

LANCEDB_URI=./lancedb_data

# IMPORTANT: set this to a long random string before deploying anywhere
# (Docker, a server, etc). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left blank, a random one is generated each time the server starts,
# which means everyone gets logged out on every restart -- fine for local
# testing, NOT fine for anything persistent.
JWT_SECRET_KEY=
